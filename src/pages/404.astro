---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import Button from '../components/primitives/Button.astro';
import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/globals.css';
import '../styles/motion.css';
---
<BaseLayout title="Page not found — Art Whisper">
  <Header />
  <main id="main" class="notfound">
    <div class="notfound__inner">
      <p class="notfound__code">404</p>
      <h1>This page walked away with a different story.</h1>
      <p class="notfound__lede">The page you're looking for doesn't exist or has moved.</p>
      <Button href="/">Back to home</Button>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .notfound {
    background: var(--color-bg-white);
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px var(--space-6) 80px;
  }

  .notfound__inner {
    max-width: var(--container-narrow);
    margin: 0 auto;
    text-align: center;
  }

  .notfound__code {
    font-family: var(--font-serif);
    font-size: var(--text-section-h);
    color: var(--color-accent-hover);
    margin: 0 0 8px;
  }

  .notfound__inner h1 {
    font-family: var(--font-serif);
    font-size: var(--text-section-h);
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    margin: 0 0 16px;
  }

  .notfound__lede {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 32px;
  }

  @media (max-width: 767px) {
    .notfound {
      padding: 96px var(--space-6) 48px;
    }
  }
</style>
