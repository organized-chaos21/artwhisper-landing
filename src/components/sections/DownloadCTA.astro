---
import Eyebrow from '../primitives/Eyebrow.astro';
---
<section class="download-cta" id="download" data-animate="section">
  <div class="download-cta__inner">
    <Eyebrow>GET THE APP</Eyebrow>

    <h2>Walk in. Walk out<br />with stories.</h2>

    <p class="download-cta__subhead">
      Made with care for art lovers. On Android now. iPhone coming soon.
    </p>

    <div class="download-cta__buttons">
      <a
        href="https://play.google.com/store/apps/details?id=app.artwhisper&utm_source=landing&utm_medium=cta_final&utm_campaign=playstore"
        class="play-badge"
        target="_blank"
        rel="noopener"
        aria-label="Get Art Whisper on Google Play"
      >
        <svg class="play-badge__icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3"/></svg>
        <span class="play-badge__text">
          <span class="play-badge__label">GET IT ON</span>
          <span class="play-badge__store">Google Play</span>
        </span>
      </a>

      <div class="ios-badge" aria-label="iPhone app coming soon">
        <svg class="ios-badge__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 5-2.55 5-5.5 0-1.93-1.57-3.5-3.5-3.5-1.4 0-2.1.5-3 .5s-1.6-.5-3-.5c-3.04 0-5.5 2.46-5.5 5.5 0 3 1.75 5.5 5 5.5 1.25 0 2.5-1.06 4-1.06z"/><path d="M12 7c2-3 5-4 5-4s-1 3-3 5"/></svg>
        <span class="ios-badge__text">
          <span class="ios-badge__label">COMING SOON</span>
          <span class="ios-badge__store">iPhone</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .download-cta {
    background: var(--color-bg-white);
    padding: 140px var(--space-6) 96px;
  }

  .download-cta__inner {
    max-width: var(--container-default);
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .download-cta__inner :global(.eyebrow) {
    margin-bottom: 20px;
  }

  h2 {
    font-family: var(--font-serif);
    font-size: var(--text-cta-h);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -1.5px;
    margin: 0;
  }

  .download-cta__subhead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 28px 0 0 0;
  }

  .download-cta__buttons {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 56px;
  }

  .play-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px;
    background: var(--color-text-primary);
    color: white;
    border-radius: var(--border-radius-md);
    text-decoration: none;
    height: 52px;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .play-badge:hover {
    opacity: 0.85;
    color: white;
  }

  .play-badge__icon {
    color: var(--color-accent);
  }

  .play-badge__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .play-badge__label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5px;
    opacity: 0.8;
  }

  .play-badge__store {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.2px;
  }

  .ios-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px;
    border: 1px solid rgba(12, 12, 16, 0.14);
    border-radius: var(--border-radius-md);
    height: 52px;
    cursor: not-allowed;
    pointer-events: none;
  }

  .ios-badge__icon {
    color: var(--color-text-tertiary);
  }

  .ios-badge__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .ios-badge__label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: var(--color-text-tertiary);
  }

  .ios-badge__store {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: var(--color-text-secondary);
  }

  @media (max-width: 767px) {
    .download-cta {
      padding: 96px var(--space-6) 64px;
    }
    .download-cta__buttons {
      flex-direction: column;
      width: 100%;
      max-width: 280px;
      margin-top: 40px;
    }
    .play-badge, .ios-badge {
      width: 100%;
      justify-content: center;
    }
  }
</style>
