---
import SectionHeader from '../primitives/SectionHeader.astro';

const plans = [
  {
    tag: 'WELCOME',
    title: 'Start here',
    price: 'Free',
    priceItalic: false,
    priceMuted: false,
    body: 'Fifteen scans included when you sign up. Full identification, full stories, full audio narration. Same Art Whisper, no different experience.',
    footer: 'No card. No trial countdown.',
    highlighted: false,
    badge: null,
  },
  {
    tag: 'WHEN YOU WANT MORE',
    title: 'Scan packs',
    price: '30 or 100 scans',
    priceItalic: false,
    priceMuted: false,
    body: 'Buy a pack when your fifteen run out. Use them on one museum trip or spread them across a year. They don\u2019t expire, ever.',
    footer: 'One-time payment. Shown in the app.',
    highlighted: true,
    badge: 'Most popular',
  },
  {
    tag: 'FOR REGULARS',
    title: 'Subscriptions',
    price: 'Coming soon',
    priceItalic: true,
    priceMuted: true,
    body: 'Monthly and yearly plans for museum regulars and frequent travelers. Unlimited scans, priority audio, more on the way.',
    footer: 'Arriving later this year.',
    highlighted: false,
    badge: null,
  },
];
---
<section class="pricing" id="pricing" data-animate="section">
  <div class="pricing__inner">
    <SectionHeader
      eyebrow="PRICING"
      headline="Free to begin. Yours when you want more."
      subhead="Fifteen scans on us when you sign up. After that, packs only when you want them. No automatic renewals."
    />

    <div class="pricing__grid">
      {plans.map(plan => (
        <div class={`pricing__card ${plan.highlighted ? 'pricing__card--highlighted' : ''}`}>
          {plan.badge && (
            <span class="pricing__badge">{plan.badge}</span>
          )}
          <span class="pricing__tag">{plan.tag}</span>
          <h3 class="pricing__title">{plan.title}</h3>
          <p class={`pricing__price ${plan.priceItalic ? 'pricing__price--italic' : ''} ${plan.priceMuted ? 'pricing__price--muted' : ''}`}>
            {plan.price}
          </p>
          <p class="pricing__body">{plan.body}</p>
          <p class="pricing__footer">{plan.footer}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing {
    background: #FFFFFF;
    padding: 120px var(--space-6);
  }

  .pricing__inner {
    max-width: var(--container-default);
    margin: 0 auto;
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 64px;
  }

  .pricing__card {
    position: relative;
    background: #FAF6EF;
    border: 1px solid rgba(12, 12, 16, 0.08);
    border-radius: 16px;
    padding: 40px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pricing__card--highlighted {
    border: 1.5px solid #D4882C;
  }

  .pricing__badge {
    position: absolute;
    top: 16px;
    right: 20px;
    background: #D4882C;
    color: #FFFBF5;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    padding: 5px 14px;
    border-radius: 100px;
  }

  .pricing__tag {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2.5px;
    color: #A86E22;
    text-transform: uppercase;
  }

  .pricing__title {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 12px 0 0 0;
  }

  .pricing__price {
    font-family: var(--font-serif);
    font-size: 36px;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 16px 0 0 0;
  }

  .pricing__price--italic {
    font-style: italic;
  }

  .pricing__price--muted {
    color: rgba(90, 90, 94, 0.6);
  }

  .pricing__body {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
    color: #5A5A5E;
    margin: 20px 0 0 0;
  }

  .pricing__footer {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    color: rgba(90, 90, 94, 0.6);
    margin: 16px 0 0 0;
  }

  @media (max-width: 767px) {
    .pricing {
      padding: 64px var(--space-6);
    }

    .pricing__grid {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 40px;
    }

    .pricing__card {
      padding: 32px 24px;
    }

    .pricing__badge {
      top: 14px;
      right: 16px;
      font-size: 10px;
      padding: 4px 12px;
    }

    .pricing__tag {
      font-size: 11px;
      letter-spacing: 2px;
    }

    .pricing__title {
      font-size: 22px;
      margin-top: 10px;
    }

    .pricing__price {
      font-size: 30px;
      margin-top: 12px;
    }

    .pricing__body {
      font-size: 14px;
      margin-top: 16px;
    }

    .pricing__footer {
      font-size: 12px;
      margin-top: 12px;
    }
  }
</style>
