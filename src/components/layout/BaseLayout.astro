---
import IosWaitlistModal from '../sections/IosWaitlistModal.astro';
const { title = "Art Whisper — Stand in front of any painting. Walk away with its story." } = Astro.props;

// Per-page canonical / og:url. Hardcoding the homepage here made every page
// (privacy, terms) declare `/` as its canonical, so Google treated them as
// duplicates and left them "Discovered – currently not indexed".
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/paintings/starry-night.jpeg', Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="The wall label gives you a name and a year. We pick up where it leaves off: the artist's life, the hidden details, and the story most visitors walk right past." />

  <title>{title}</title>

  <!-- Canonical -->
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content="Every painting has a story. Art Whisper tells it." />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <slot />
  <IosWaitlistModal />

  <script>
    import { initSectionAnimations, initStickyHeader } from '../../lib/motion.js';
    import { initIosWaitlist } from '../../lib/iosWaitlist.js';
    initSectionAnimations();
    initStickyHeader();
    initIosWaitlist();

    // Anchor-scroll correction. The section reveal animations and the
    // `display=swap` web-font reflow change layout *after* the browser's
    // initial hash jump, so deep links (e.g. /#support) overshoot the
    // target. Re-scroll once the page has fully settled.
    function scrollToHashTarget() {
      const { hash } = window.location;
      if (!hash || hash.length < 2) return;
      let el;
      try { el = document.querySelector(hash); } catch { return; }
      if (el) el.scrollIntoView({ behavior: 'instant', block: 'start' });
    }
    if (window.location.hash) {
      const fontsReady = document.fonts ? document.fonts.ready : Promise.resolve();
      const loaded = document.readyState === 'complete'
        ? Promise.resolve()
        : new Promise((res) => window.addEventListener('load', res, { once: true }));
      Promise.all([fontsReady, loaded]).then(() =>
        requestAnimationFrame(scrollToHashTarget)
      );
    }
  </script>
</body>
</html>
